{
  "name": "prestron-media-encoder",
  "version": "0.1.0-alpha.0",
  "description": "Interactive CLI tool for batch-encoding movies, TV series and anime to HEVC using FFmpeg — without ever risking your originals.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prestron": "dist/bin/prestron.js",
    "pme": "dist/bin/prestron.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/bin/prestron.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "ffmpeg",
    "hevc",
    "h265",
    "media-encoder",
    "video",
    "batch-encode",
    "mkv",
    "anime",
    "cli",
    "interactive"
  ],
  "author": "Munu Preston",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrestonCash/Prestron-Media-Encoder.git"
  },
  "bugs": {
    "url": "https://github.com/PrestonCash/Prestron-Media-Encoder/issues"
  },
  "homepage": "https://github.com/PrestonCash/Prestron-Media-Encoder#readme",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "execa": "^9.3.0",
    "ink": "^5.0.1",
    "ora": "^8.1.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.10.0",
    "ink-testing-library": "^3.0.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vitest": "^2.1.1"
  }
}
